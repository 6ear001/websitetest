# Copy to .env and adjust. All values are optional.

# Public URL of the live site (no trailing slash). Used for canonical, hreflang, sitemap and Open Graph.
SITE_URL=https://www.example.com

# Endpoint the quote form POSTs to (e.g. a self-hosted form handler).
# Leave empty to use the mailto fallback (opens the visitor's e-mail program).
PUBLIC_FORM_ENDPOINT=
