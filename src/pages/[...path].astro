---
/**
 * One route for every page in every language. URLs come from src/i18n/config.ts,
 * texts from src/i18n/<lang>.ts – adding a language needs no new page files.
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import About from '../views/About.astro';
import Contact from '../views/Contact.astro';
import Home from '../views/Home.astro';
import Imprint from '../views/Imprint.astro';
import Privacy from '../views/Privacy.astro';
import Services from '../views/Services.astro';
import { locales, pageKeys, pathFor, t, type Locale, type PageKey } from '../i18n';

export const getStaticPaths = (() =>
  locales.flatMap((lang) =>
    pageKeys.map((page) => ({
      params: { path: pathFor(page, lang).replace(/^\/|\/$/g, '') || undefined },
      props: { lang, page },
    })),
  )) satisfies GetStaticPaths;

interface Props {
  lang: Locale;
  page: PageKey;
}

const { lang, page } = Astro.props;
const views = { home: Home, services: Services, about: About, contact: Contact, imprint: Imprint, privacy: Privacy };
const View = views[page];
const meta = t(lang).meta[page];
---

<BaseLayout lang={lang} page={page} title={meta.title} description={meta.description}>
  <View lang={lang} />
</BaseLayout>
