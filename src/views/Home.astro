---
import CtaBand from '../components/CtaBand.astro';
import HeroArt from '../components/HeroArt.astro';
import BrandText from '../components/BrandText.astro';
import Highlight from '../components/Highlight.astro';
import Icon from '../components/Icon.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { pathFor, t, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const d = t(lang);
const h = d.home;
const services = pathFor('services', lang);

const serviceCards = [
  { ...h.services.storage, icon: 'storage' as const, href: `${services}#lagerung`, n: '01' },
  { ...h.services.shipping, icon: 'shipping' as const, href: `${services}#versand`, n: '02' },
];
const stepIcons = ['request', 'offer', 'inbound', 'outbound'] as const;
const whyIcons = ['hand', 'person', 'tailor', 'group'] as const;
---

<!-- Hero -->
<section class="relative overflow-hidden bg-ink text-white">
  <div class="bg-dots absolute inset-0" aria-hidden="true"></div>
  <div class="container-site relative grid items-center gap-10 py-14 sm:py-20 lg:grid-cols-[1.1fr_1fr] lg:gap-12 lg:py-28">
    <div>
      <p class="eyebrow text-brand">{h.hero.eyebrow}</p>
      <h1 class="h-display mt-5"><Highlight text={h.hero.title} highlight={h.hero.highlight} /></h1>
      <p class="lead mt-6 max-w-xl text-neutral-300">{h.hero.lead}</p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <a href={`${pathFor('contact', lang)}#anfrage`} class="btn btn-primary">
          {h.hero.primary}
          <Icon name="arrow" size={20} />
        </a>
        <a href={services} class="btn btn-outline-light">{h.hero.secondary}</a>
      </div>
      <p class="mt-5 flex items-center gap-2 text-sm text-neutral-400">
        <Icon name="check" size={18} class="text-brand" />
        {h.hero.note}
      </p>
    </div>
    <HeroArt class="mx-auto w-full max-w-md lg:max-w-none" />
  </div>
</section>

<!-- Services overview -->
<section class="bg-white py-20 lg:py-28" aria-labelledby="services-title">
  <div class="container-site">
    <SectionHeader id="services-title" eyebrow={h.services.eyebrow} title={h.services.title} intro={h.services.intro} />
    <ul class="mt-12 grid gap-6 md:grid-cols-2">
      {
        serviceCards.map((card) => (
          <li class="reveal">
            <article class="card card-hover flex h-full flex-col p-7 sm:p-9">
              <div class="flex items-start justify-between gap-4">
                <span class="crate-icon">
                  <Icon name={card.icon} size={28} />
                </span>
                <span
                  class="text-5xl font-extrabold text-neutral-200 after:content-[attr(data-n)]"
                  data-n={card.n}
                  aria-hidden="true"
                />
              </div>
              <h3 class="mt-6 text-2xl">{card.title}</h3>
              <p class="mt-3 flex-1 text-neutral-700">{card.text}</p>
              <p class="mt-6">
                <a href={card.href} class="link-arrow">
                  {card.link}
                  <Icon name="arrow" size={18} />
                </a>
              </p>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<!-- Process -->
<section class="bg-neutral-100 py-20 lg:py-28" aria-labelledby="process-title">
  <div class="container-site">
    <SectionHeader id="process-title" eyebrow={h.process.eyebrow} title={h.process.title} intro={h.process.intro} />
    <div class="relative mt-14">
      <div
        class="reveal-line pointer-events-none absolute start-7 end-[calc((100%-6rem)/4-1.75rem)] top-[1.6rem] hidden h-[3px] origin-left bg-ink lg:block rtl:origin-right"
        aria-hidden="true"
      >
      </div>
    <ol class="relative grid gap-6 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      {
        h.process.steps.map((step, i) => (
          <li class="reveal relative">
            <div class="relative z-10 flex items-center gap-4 lg:flex-col lg:items-start">
              <span class="crate-icon h-14 w-14 text-lg font-extrabold text-white">
                <span>{String(i + 1).padStart(2, '0')}</span>
              </span>
              <Icon name={stepIcons[i]!} size={28} class="text-ink lg:hidden" />
            </div>
            <h3 class="mt-5 flex items-center gap-2 text-xl">
              <Icon name={stepIcons[i]!} size={22} class="hidden text-ink lg:block" />
              {step.title}
            </h3>
            <p class="mt-2 text-neutral-700">{step.text}</p>
          </li>
        ))
      }
    </ol>
    </div>
  </div>
</section>

<!-- Why us -->
<section class="relative overflow-hidden bg-ink py-20 text-white lg:py-28" aria-labelledby="why-title">
  <div class="bg-dots absolute inset-0" aria-hidden="true"></div>
  <div class="container-site relative">
    <SectionHeader id="why-title" tone="dark" eyebrow={h.why.eyebrow} title={h.why.title} intro={h.why.intro} />
    <ul class="mt-12 grid gap-5 sm:grid-cols-2">
      {
        h.why.items.map((item, i) => (
          <li class="card-dark reveal flex gap-5 p-6 sm:p-8">
            <span class="grid h-12 w-12 flex-none place-items-center rounded-[10px] bg-brand text-ink">
              <Icon name={whyIcons[i] ?? 'check'} size={24} />
            </span>
            <div>
              <h3 class="text-xl"><BrandText text={item.title} /></h3>
              <p class="mt-2 text-neutral-300">{item.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<CtaBand cta={h.cta} lang={lang} />
