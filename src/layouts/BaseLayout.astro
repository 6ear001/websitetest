---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { company } from '../config/site';
import { localeMeta, locales, pathFor, t, type Locale, type PageKey } from '../i18n';
import { absolute, alternates } from '../lib/urls';

interface Props {
  lang: Locale;
  /** undefined for the 404 page */
  page?: PageKey;
  title: string;
  description: string;
  noindex?: boolean;
}

const { lang, page, title, description, noindex = false } = Astro.props;
const d = t(lang);
const meta = localeMeta[lang];
const site = Astro.site;

const canonical = page ? absolute(pathFor(page, lang), site) : undefined;
const alts = page ? alternates(page, site) : [];
const ogImage = absolute('/og-image.png', site);

// JSON-LD: deliberately only name, address, phone and e-mail (no unverified data).
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: company.name,
  address: {
    '@type': 'PostalAddress',
    streetAddress: company.address.street,
    postalCode: company.address.postalCode,
    addressLocality: company.address.city,
    addressCountry: company.address.countryCode,
  },
  telephone: company.phone.href,
  email: company.email,
};

const fontPreload =
  lang === 'ar' ? '/fonts/noto-kufi-arabic-var.woff2' : '/fonts/montserrat-latin-var.woff2';
---

<!doctype html>
<html lang={lang} dir={meta.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {alts.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}

    <link rel="preload" href={fontPreload} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#000000" />
    <meta name="format-detection" content="telephone=no" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={d.brandName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={d.brandName} />
    <meta property="og:locale" content={meta.ogLocale} />
    {
      locales
        .filter((l) => l !== lang)
        .map((l) => <meta property="og:locale:alternate" content={localeMeta[l].ogLocale} />)
    }
    <meta name="twitter:card" content="summary_large_image" />

    {page && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">{d.ui.skipToContent}</a>
    <Header lang={lang} page={page} />
    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
