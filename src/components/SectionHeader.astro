---
import BrandText from './BrandText.astro';

interface Props {
  eyebrow: string;
  title: string;
  intro?: string | undefined;
  tone?: 'light' | 'dark';
  id?: string;
  class?: string;
}
const { eyebrow, title, intro, tone = 'light', id, class: className } = Astro.props;
const dark = tone === 'dark';
---

<div class:list={['max-w-3xl', className]}>
  <p class:list={['eyebrow', dark ? 'text-brand' : 'text-ink']}>{eyebrow}</p>
  <h2 id={id} class="h-section mt-4"><BrandText text={title} /></h2>
  {intro && <p class:list={['lead mt-5', dark ? 'text-neutral-300' : 'text-neutral-700']}>{intro}</p>}
</div>
