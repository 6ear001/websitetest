---
/**
 * Small inline stroke icons (no icon font, no external requests).
 * Decorative by default (aria-hidden); pass `label` to make it meaningful.
 */
interface Props {
  name: keyof typeof paths;
  size?: number;
  class?: string;
  label?: string;
}

const paths = {
  arrow: '<path d="M4 12h15"/><path d="M13 6l6 6-6 6"/>',
  phone:
    '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M3.5 7l8.5 6 8.5-6"/>',
  pin: '<path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>',
  menu: '<path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/>',
  close: '<path d="M6 6l12 12"/><path d="M18 6L6 18"/>',
  check: '<path d="M5 12.5l4.5 4.5L19 7.5"/>',
  plus: '<path d="M12 5v14"/><path d="M5 12h14"/>',
  external: '<path d="M14 4h6v6"/><path d="M20 4l-9 9"/><path d="M18 14v4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4"/>',
  // storage: three stacked crates
  storage:
    '<rect x="3" y="14" width="18" height="7" rx="2"/><rect x="5" y="8" width="14" height="6" rx="2"/><rect x="7" y="3" width="10" height="5" rx="1.5"/>',
  // shipping: crate with outgoing arrow
  shipping:
    '<rect x="2.5" y="8" width="11" height="11" rx="2"/><path d="M8 8v4"/><path d="M15 13.5h6.5"/><path d="M18.5 10.5l3 3-3 3"/>',
  request: '<rect x="5" y="3" width="14" height="18" rx="2.5"/><path d="M9 8h6"/><path d="M9 12h6"/><path d="M9 16h3"/>',
  offer: '<path d="M7 3h7l5 5v11a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"/><path d="M14 3v5h5"/><path d="M8.5 14.5l2.5 2.5 4.5-4.5"/>',
  inbound: '<rect x="3" y="11" width="18" height="10" rx="2"/><path d="M12 3v9"/><path d="M8.5 8.5L12 12l3.5-3.5"/>',
  outbound: '<rect x="3" y="11" width="18" height="10" rx="2"/><path d="M12 12V3"/><path d="M8.5 6.5L12 3l3.5 3.5"/>',
  hand: '<path d="M4 13l4-4 3 2 4-4 5 5"/><path d="M4 13v6h16v-6"/><path d="M9 19v-4h6v4"/>',
  person: '<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>',
  tailor: '<path d="M4 20L20 4"/><path d="M7 17l2 2"/><path d="M10 14l2 2"/><path d="M13 11l2 2"/><path d="M16 8l2 2"/>',
  group: '<rect x="3" y="3" width="8" height="8" rx="2"/><rect x="13" y="3" width="8" height="8" rx="2"/><rect x="8" y="13" width="8" height="8" rx="2"/>',
  eye: '<path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z"/><circle cx="12" cy="12" r="3"/>',
  doc: '<path d="M7 3h7l5 5v11a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"/><path d="M9 13h6"/><path d="M9 17h6"/>',
  care: '<path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/>',
} as const;

const { name, size = 24, class: className, label } = Astro.props;
const a11y = label ? ({ role: 'img', 'aria-label': label } as const) : ({ 'aria-hidden': 'true' } as const);
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={[`icon-${name}`, className]}
  focusable="false"
  {...a11y}
  set:html={paths[name]}
/>
