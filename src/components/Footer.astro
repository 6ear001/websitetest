---
import Icon from './Icon.astro';
import { company, mapUrl } from '../config/site';
import { pathFor, t, type Locale } from '../i18n';
import { logoSrc, logos, svgSize } from '../lib/brand';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const d = t(lang);
const f = d.ui.footer;
const logoSize = svgSize(logos.horizontalOnDark);
const year = new Date().getFullYear();
const [mailUser, mailDomain] = company.email.split('@');
const services = pathFor('services', lang);

const columns = [
  {
    heading: f.servicesHeading,
    links: [
      { href: `${services}#lagerung`, label: d.services.storage.title },
      { href: `${services}#versand`, label: d.services.shipping.title },
    ],
  },
  {
    heading: f.companyHeading,
    links: [
      { href: pathFor('about', lang), label: d.ui.nav.about },
      { href: pathFor('contact', lang), label: d.ui.nav.contact },
    ],
  },
  {
    heading: f.legalHeading,
    links: [
      { href: pathFor('imprint', lang), label: d.ui.legal.imprint },
      { href: pathFor('privacy', lang), label: d.ui.legal.privacy },
    ],
  },
];
const linkClass =
  'no-underline text-neutral-300 transition-colors hover:text-white hover:underline hover:decoration-brand hover:decoration-2 hover:underline-offset-4';
---

<footer class="bg-ink text-white">
  <div class="container-site grid gap-12 py-16 lg:grid-cols-12 lg:gap-16 lg:py-20">
    <div class="lg:col-span-5">
      <a href={pathFor('home', lang)} class="inline-block">
        <img
          src={logoSrc(logos.horizontalOnDark)}
          width={logoSize.width}
          height={logoSize.height}
          alt={d.ui.homeLinkLabel}
          loading="lazy"
          class="h-10 w-auto"
        />
      </a>
      <p class="mt-5 max-w-sm text-neutral-300">{f.tagline}</p>

      <h2 class="sr-only">{f.contactHeading}</h2>
      <ul class="mt-8 space-y-4 text-neutral-300">
        <li class="flex items-start gap-3">
          <Icon name="phone" size={20} class="mt-1 flex-none text-brand" />
          <span>
            <span class="sr-only">{d.ui.phone}: </span>
            <a href={`tel:${company.phone.href}`} class={linkClass} dir="ltr">{company.phone.display}</a>
          </span>
        </li>
        <li class="flex items-start gap-3">
          <Icon name="mail" size={20} class="mt-1 flex-none text-brand" />
          <span class="min-w-0">
            <span class="sr-only">{d.ui.email}: </span>
            <a href={`mailto:${company.email}`} class={linkClass} dir="ltr">{mailUser}@<wbr />{mailDomain}</a>
          </span>
        </li>
        <li class="flex items-start gap-3">
          <Icon name="pin" size={20} class="mt-1 flex-none text-brand" />
          <span>
            <address class="not-italic">
              <span class="sr-only">{d.ui.address}: </span>
              <span dir="ltr">{company.address.street}</span><br />
              <span dir="ltr">{company.address.postalCode} {company.address.city}</span>
            </address>
            <a href={mapUrl} class:list={[linkClass, 'mt-1 inline-flex items-center gap-1.5 text-sm']}>
              {d.ui.openMap}
              <span class="sr-only">{d.ui.externalHint}</span>
              <Icon name="external" size={14} />
            </a>
          </span>
        </li>
      </ul>

      <p class="mt-8">
        <a
          href={company.sister.url}
          class="inline-flex items-center gap-3 rounded-[10px] border border-neutral-700 px-4 py-3 font-bold no-underline transition-colors hover:border-brand"
        >
          <span class="inline-block h-2.5 w-3.5 flex-none rounded-[3px] bg-brand" aria-hidden="true"></span>
          {f.groupLine}
          <span class="sr-only">– {f.groupLinkLabel} {d.ui.externalHint}</span>
          <Icon name="external" size={18} class="flex-none text-neutral-400" />
        </a>
      </p>
    </div>

    <div class="grid gap-10 sm:grid-cols-3 lg:col-span-7 lg:pt-2">
      {
        columns.map((col) => (
          <div>
            <h2 class="text-sm font-bold uppercase tracking-[0.12em] text-brand">{col.heading}</h2>
            <ul class="mt-4 space-y-3">
              {col.links.map((link) => (
                <li>
                  <a href={link.href} class={linkClass}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
  <div class="border-t border-neutral-800">
    <div class="container-site flex flex-col gap-2 py-6 text-sm text-neutral-400 sm:flex-row sm:items-center sm:justify-between">
      <p>{f.copyright.replace('{year}', String(year))}</p>
      <p lang={lang === 'ar' ? 'de' : 'ar'} dir={lang === 'ar' ? 'ltr' : 'rtl'}>
        {lang === 'ar' ? company.name : company.nameAr}
      </p>
    </div>
  </div>
</footer>
