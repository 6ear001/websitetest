---
import Icon from './Icon.astro';
import { company } from '../config/site';
import { pathFor, type CtaBlock, type Locale } from '../i18n';

interface Props {
  cta: CtaBlock;
  lang: Locale;
}
const { cta, lang } = Astro.props;
---

<section class="cta-band bg-brand text-ink" aria-labelledby="cta-title">
  <div class="container-site grid items-center gap-8 py-16 lg:grid-cols-[1fr_auto] lg:py-20">
    <div>
      <h2 id="cta-title" class="h-section max-w-3xl">{cta.title}</h2>
      <p class="lead mt-4 max-w-2xl">{cta.text}</p>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
      <a href={`${pathFor('contact', lang)}#anfrage`} class="btn btn-dark">
        {cta.button}
        <Icon name="arrow" size={20} />
      </a>
      <a href={`tel:${company.phone.href}`} class="btn btn-outline-dark">
        <Icon name="phone" size={20} />
        <span dir="ltr">{company.phone.display}</span>
      </a>
    </div>
  </div>
</section>

<style>
  /* the red focus ring would be invisible on red */
  .cta-band :global(:focus-visible) {
    outline-color: #000000;
  }
</style>
